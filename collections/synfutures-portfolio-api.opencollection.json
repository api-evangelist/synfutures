{
  "opencollection": "1.0.0",
  "info": {
    "name": "SynFutures RWA Trading Cash Portfolio API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Portfolio",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "User info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://base-api.synfutures.com/rwa/trading/api/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User info"
        },
        {
          "info": {
            "name": "Balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://base-api.synfutures.com/rwa/trading/api/v1/users/:userId/balance",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Balances"
        },
        {
          "info": {
            "name": "Positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://base-api.synfutures.com/rwa/trading/api/v1/users/:userId/positions",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Positions"
        }
      ]
    }
  ],
  "bundled": true
}